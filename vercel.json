{
  "rewrites": [
    {
      "source": "/stock",
      "destination": "/stock.html"
    },
    {
      "source": "/e/:slug",
      "destination": "/editorial.html"
    },
    {
      "source": "/:slug/pdf",
      "destination": "/api/pdf?vr=:slug"
    },
    {
      "source": "/:slug",
      "destination": "/api/room?vr=:slug"
    }
  ],
  "functions": {
    "api/room.js": {
      "includeFiles": "viewing-room.html"
    },
    "api/pdf.js": {
      "includeFiles": "files/{Replica_Regular.woff2,Replica_Bold.woff2,Replica_Italic.woff2,logo.png}",
      "maxDuration": 30
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; connect-src 'self' https://t.diez.gallery; font-src 'self'; frame-src https://player.vimeo.com https://www.youtube-nocookie.com https://www.youtube.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'"
        }
      ]
    },
    {
      "source": "/stock(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        },
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    }
  ]
}
